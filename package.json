{
  "name": "boylston-comed-record-external",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "encrypt": "RECORD_CONTENT=content-comed.json RECORD_PASSWORD=password-comed.txt node scripts/encrypt.mjs",
